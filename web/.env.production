# Production configuration that is NOT secret, committed on purpose.
#
# Next.js loads this file for production builds and `next start`, so these two
# values no longer have to be typed into a hosting dashboard — which is how they
# came to be missing from the first deployment. `.env.local` overrides this file
# locally, and `next dev` ignores it entirely, so local development is unaffected.
#
# Neither value is a credential:
#   - the Supabase URL appears in every public plate URL the browser requests
#   - CATALOG_READONLY is a behaviour flag, not a permission; the actual
#     enforcement is that the app authenticates as `catalog_read`, a role with
#     SELECT and nothing else
#
# DATABASE_URL is deliberately NOT here. It carries a password, so it belongs in
# the host's encrypted environment variables and nowhere else. `/api/health`
# reports whether it arrived.

NEXT_PUBLIC_SUPABASE_URL=https://vbyaqzkagzhatdqitfko.supabase.co
CATALOG_READONLY=1
